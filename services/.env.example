# =============================================================================
# ToggleMaster - Variáveis de Ambiente Local (Docker Compose)
# =============================================================================
# Copie para services/.env para execução com Docker Compose
# =============================================================================

# Chave mestra do Auth Service
MASTER_KEY=admin-secreto-123

# Chave de API de serviço gerada pelo auth-service para o evaluation-service
SERVICE_API_KEY=tm_key_local_dev_secret

# AWS Config (usando DynamoDB Local e SQS mock/real)
AWS_REGION=us-east-1
AWS_SQS_URL=https://sqs.us-east-1.amazonaws.com/000000000000/togglemaster-events
AWS_DYNAMODB_TABLE=ToggleMasterAnalytics
AWS_ENDPOINT_URL_DYNAMODB=http://dynamodb-local:8000
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_SESSION_TOKEN=
