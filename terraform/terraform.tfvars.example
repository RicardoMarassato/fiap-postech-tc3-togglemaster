# =============================================================================
# ToggleMaster - Variáveis de Configuração
# =============================================================================
# Copie este arquivo para terraform.tfvars e ajuste os valores conforme necessário
# IMPORTANTE: Não commite o terraform.tfvars com dados sensíveis!
# =============================================================================

# -----------------------------------------------------------------------------
# Configuração Geral
# -----------------------------------------------------------------------------
aws_region   = "us-east-1"
project_name = "togglemaster"
environment  = "dev"  # dev, staging, prod

# -----------------------------------------------------------------------------
# AWS Academy LabRole
# -----------------------------------------------------------------------------
# Para AWS Academy, deixe use_lab_role = true
# O Terraform irá buscar automaticamente a LabRole via data source
use_lab_role = true

# Para conta pessoal, use:
# use_lab_role = false
# lab_role_arn = "arn:aws:iam::123456789012:role/YourCustomRole"

# -----------------------------------------------------------------------------
# Networking
# -----------------------------------------------------------------------------
vpc_cidr             = "10.0.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b"]
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.10.0/24", "10.0.20.0/24"]

# -----------------------------------------------------------------------------
# EKS
# -----------------------------------------------------------------------------
eks_cluster_version     = "1.29"
eks_node_instance_types = ["t3.medium"]
eks_node_desired_size   = 2
eks_node_min_size       = 1
eks_node_max_size       = 4

# -----------------------------------------------------------------------------
# RDS (PostgreSQL)
# -----------------------------------------------------------------------------
rds_instance_class    = "db.t3.micro"
rds_allocated_storage = 20
rds_engine_version    = "16.3"
rds_multi_az          = false  # true para produção

# -----------------------------------------------------------------------------
# ElastiCache (Redis)
# -----------------------------------------------------------------------------
redis_node_type       = "cache.t3.micro"
redis_num_cache_nodes = 1
redis_engine_version  = "7.1"

# -----------------------------------------------------------------------------
# DynamoDB
# -----------------------------------------------------------------------------
dynamodb_billing_mode = "PAY_PER_REQUEST"  # ou "PROVISIONED"

# -----------------------------------------------------------------------------
# ECR
# -----------------------------------------------------------------------------
ecr_image_tag_mutability = "MUTABLE"  # ou "IMMUTABLE"
ecr_scan_on_push         = true
