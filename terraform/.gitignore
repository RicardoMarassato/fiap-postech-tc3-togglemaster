# =============================================================================
# Terraform GitIgnore
# =============================================================================

# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json
!*.tfvars.example

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore lock file (opcional - alguns times preferem commitar)
# .terraform.lock.hcl

# Ignore plan output files
*.tfplan
*.plan

# Ignore any .pem or key files
*.pem
*.key
